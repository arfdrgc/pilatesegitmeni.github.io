---
// Side-profile articulated figure, facing right. Each joint is a nested <g>
// rotated by CSS around its pivot, so a parent's rotation carries everything
// above it (knee → hip → mid-back → neck → head, with the arms on the ribcage).
// Upright, ear, shoulder, hip, knee and ankle sit on the plumb line at x=150.
//
// Poses are driven by inherited custom properties (--p-arm, --p-arm-back,
// --p-elbow, --plumb) that a parent element may set; with `animated`, the
// figure starts slouched and stacks up from the knees to the head on load.
import type { AlignmentPoint } from './copy';

interface Props {
  label: string;
  animated?: boolean;
  /** Names of the alignment points, drawn to the left of the plumb line. */
  points?: Record<AlignmentPoint, string>;
  class?: string;
}

const { label, animated = false, points, class: className } = Astro.props;

const PLUMB_X = 150;
const pointY: Record<AlignmentPoint, number> = { ear: 80, shoulder: 132, hip: 240, knee: 330, ankle: 420 };
---

<svg
  class:list={['fig', animated && 'fig--animated', className]}
  viewBox="0 0 300 460"
  role="img"
  aria-label={label}
>
  <line class="fig__floor" x1="92" y1="441" x2="208" y2="441"></line>
  <line class="fig__plumb" x1={PLUMB_X} y1="22" x2={PLUMB_X} y2="441"></line>

  <!-- Feet and shins stay planted. -->
  <line class="seg seg--back" x1="142" y1="432" x2="170" y2="432" stroke-width="14"></line>
  <line class="seg seg--back" x1="144" y1="340" x2="144" y2="412" stroke-width="22"></line>
  <line class="seg seg--limb" x1="148" y1="432" x2="178" y2="432" stroke-width="14"></line>
  <line class="seg seg--limb" x1="150" y1="340" x2="150" y2="412" stroke-width="22"></line>

  <g class="j j-knee">
    <line class="seg seg--back" x1="144" y1="250" x2="144" y2="322" stroke-width="26"></line>
    <line class="seg seg--limb" x1="150" y1="250" x2="150" y2="322" stroke-width="26"></line>

    <g class="j j-hip">
      <line class="seg seg--body" x1="150" y1="236" x2="150" y2="250" stroke-width="50"></line>

      <g class="j j-mid">
        <g class="j j-arm-back">
          <line class="seg seg--back" x1="150" y1="138" x2="150" y2="198" stroke-width="18"></line>
          <g class="j j-elbow">
            <line class="seg seg--back" x1="150" y1="212" x2="150" y2="262" stroke-width="16"></line>
            <circle class="seg-fill seg-fill--back" cx="150" cy="276" r="9"></circle>
          </g>
        </g>

        <line class="seg seg--body" x1="150" y1="150" x2="150" y2="178" stroke-width="54"></line>

        <g class="j j-neck">
          <line class="seg seg--body" x1="150" y1="122" x2="151" y2="104" stroke-width="16"></line>
          <g class="j j-head">
            <circle class="seg-fill" cx="134" cy="59" r="11"></circle>
            <circle class="seg-fill" cx="156" cy="78" r="25"></circle>
            <circle class="pin" cx={PLUMB_X} cy={pointY.ear} r="3"></circle>
          </g>
        </g>

        <g class="j j-arm">
          <line class="seg seg--halo" x1="150" y1="138" x2="150" y2="198" stroke-width="23"></line>
          <line class="seg seg--limb" x1="150" y1="138" x2="150" y2="198" stroke-width="18"></line>
          <g class="j j-elbow">
            <line class="seg seg--halo" x1="150" y1="212" x2="150" y2="262" stroke-width="21"></line>
            <circle class="seg-fill seg-fill--halo" cx="150" cy="276" r="11.5"></circle>
            <line class="seg seg--limb" x1="150" y1="212" x2="150" y2="262" stroke-width="16"></line>
            <circle class="seg-fill" cx="150" cy="276" r="9"></circle>
          </g>
          <circle class="pin" cx={PLUMB_X} cy={pointY.shoulder} r="3"></circle>
        </g>
      </g>
      <circle class="pin" cx={PLUMB_X} cy={pointY.hip} r="3"></circle>
    </g>
    <circle class="pin" cx={PLUMB_X} cy={pointY.knee} r="3"></circle>
  </g>
  <circle class="pin" cx={PLUMB_X} cy={pointY.ankle} r="3"></circle>

  {
    Object.entries(pointY).map(([, y]) => (
      <circle class="fig__mark" cx={PLUMB_X} cy={y} r="7.5" />
    ))
  }

  {
    points &&
      (Object.keys(pointY) as AlignmentPoint[]).map((point) => (
        <g class="fig__point">
          <line x1="108" y1={pointY[point]} x2="138" y2={pointY[point]} />
          <text x="102" y={pointY[point]} dy="0.35em" text-anchor="end">
            {points[point]}
          </text>
        </g>
      ))
  }
</svg>

<style>
  .fig {
    display: block;
    overflow: visible;
  }

  /* Segments are round-capped strokes: limbs in ink, torso and neck in sage,
     the far-side limbs muted. A paper-coloured halo separates the near arm. */
  .seg {
    fill: none;
    stroke-linecap: round;
  }

  .seg--limb {
    stroke: var(--color-text);
  }

  .seg--body {
    stroke: var(--color-sage);
  }

  .seg--back {
    stroke: var(--color-muted);
    opacity: 0.55;
  }

  .seg--halo {
    stroke: var(--color-bg);
  }

  .seg-fill {
    fill: var(--color-text);
  }

  .seg-fill--back {
    fill: var(--color-muted);
    opacity: 0.55;
  }

  .seg-fill--halo {
    fill: var(--color-bg);
  }

  .pin {
    fill: var(--color-bg);
  }

  .fig__floor {
    stroke: var(--color-rule);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .fig__plumb {
    stroke: var(--color-accent);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    opacity: calc(0.45 + 0.55 * var(--plumb, 0));
    transform-box: view-box;
    transform-origin: 150px 22px;
    transition: opacity 0.4s ease;
  }

  .fig__mark {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    scale: calc(1 + 0.25 * var(--plumb, 0));
    transition: scale 0.4s ease;
  }

  .fig__point line {
    stroke: var(--color-accent);
    stroke-width: 1;
  }

  .fig__point text {
    fill: var(--color-text);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
  }

  /* Joints: rotation around each pivot, in viewBox units. */
  .j {
    transform-box: view-box;
    transform: rotate(var(--pose, 0deg));
    transition: transform 0.7s cubic-bezier(0.3, 0, 0.2, 1);
  }

  .j-knee {
    transform-origin: 150px 330px;
    --from: 5deg;
    --delay: 0.3s;
  }

  .j-hip {
    transform-origin: 150px 240px;
    --from: -10deg;
    --delay: 0.4s;
  }

  .j-mid {
    transform-origin: 150px 208px;
    --from: 18deg;
    --delay: 0.6s;
  }

  .j-neck {
    transform-origin: 150px 122px;
    --from: 16deg;
    --delay: 0.8s;
  }

  .j-head {
    transform-origin: 151px 100px;
    --from: -18deg;
    --delay: 0.9s;
  }

  .j-arm,
  .j-arm-back {
    transform-origin: 150px 132px;
    --from: -20deg;
    --delay: 0.7s;
  }

  .j-arm {
    --pose: var(--p-arm, 0deg);
  }

  .j-arm-back {
    --pose: var(--p-arm-back, 0deg);
  }

  .j-elbow {
    transform-origin: 150px 206px;
    --pose: var(--p-elbow, 0deg);
    --from: -6deg;
    --delay: 0.8s;
  }

  /* Load sequence: slouched → stacked, bottom-up like rolling up through the
     spine. Only the start state is a keyframe; the end is each joint's pose.
     Then the plumb line draws in and the alignment marks settle onto it. */
  .fig--animated .j {
    animation: fig-stack 1.5s cubic-bezier(0.55, 0, 0.2, 1) var(--delay) backwards;
  }

  .fig--animated .fig__plumb {
    animation: fig-plumb 0.9s cubic-bezier(0.4, 0, 0.2, 1) 1.5s backwards;
  }

  .fig--animated .fig__mark {
    animation: fig-mark 0.6s cubic-bezier(0.3, 0, 0.2, 1.4) 2.1s backwards;
  }

  @keyframes fig-stack {
    from {
      transform: rotate(var(--from));
    }
  }

  @keyframes fig-plumb {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes fig-mark {
    from {
      opacity: 0;
      scale: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fig--animated .j,
    .fig--animated .fig__plumb,
    .fig--animated .fig__mark {
      animation: none;
    }
  }
</style>
