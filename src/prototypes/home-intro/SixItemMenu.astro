---
// The six-item ring menu (owner, 2026-10-29), in HomeIntro.astro's `menu`
// slot: on the dev preview (HomeIntroPreview.astro with `menu="six"`, at
// /dev/home-menu/ and /en/dev/home-menu/) and, with `homepage`, on / and /en/
// (../../components/ComingSoon.astro, owner, 2026-10-30). Items, labels,
// icons and destinations come from src/config/home-menu.ts.
// - Each icon sits on the ring at its hour (half past 1, 3, half past 4,
//   half past 7, 9, half past 10), where the homepage's dot sits; the label
//   reaches outwards from it, away from the ring: to the left on the clock's
//   left half, to the right on its right half. Long labels wrap onto two
//   lines on phones.
// - The scene (../../components/home-intro/dotScene.ts, unchanged) fades the
//   ring's items in document order, 150 ms apart, once she stands in the
//   front view; the items are listed in the config's reveal order for that.
// - The section pages don't exist yet, so on the dev preview their links
//   lead to the dev server's 404 page. On the homepage (`homepage`) those
//   items show their icon and label but are not links until their pages
//   exist in both languages (owner, 2026-10-30): an <a> without href, which
//   the scene fades as it does a link. İlham, Instagram, stays a link.
import { PALETTES } from '../../components/dot-figure/palettes';
import { ringPoint, STAGE } from '../../components/home-intro/geometry';
import brand from '../../config/brand.json';
import { homeMenu, revealOrder, type MenuIcon } from '../../config/home-menu';
import { ritual } from '../../config/ritual';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** On the homepage: only items whose destination exists are links (see above). */
  homepage?: boolean;
}

const { lang, homepage = false } = Astro.props;
const handle = brand.instagramHandle;
/**
 * The icons at rest: the figure's own sage, the first tone of its approved
 * Clay and Sage palette (her feet and legs), soft against the page ground
 * (2.4:1; each icon's label carries its meaning). Active: --color-sage.
 */
const restColour = PALETTES.find((palette) => palette.id === 'clay-sage')!.stops[0];

/** The icons, on a 24-unit grid: thin strokes (`.f`: a filled dot). */
const icons: Record<MenuIcon, string> = {
  // The sun: a disc and eight rays.
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.64 5.64l1.77 1.77M16.6 16.6l1.77 1.77M18.36 5.64l-1.77 1.77M5.64 18.36l1.77-1.77"/>',
  // A centre and an orbit about it, a dot travelling on it.
  orbit: '<circle class="f" cx="12" cy="12" r="1.9"/><circle cx="12" cy="12" r="8.5"/><circle class="f" cx="18.01" cy="5.99" r="2"/>',
  // Seven dots: one at the centre, six around it.
  seven:
    '<circle class="f" cx="12" cy="12" r="1.6"/><circle class="f" cx="12" cy="5.4" r="1.6"/><circle class="f" cx="17.72" cy="8.7" r="1.6"/><circle class="f" cx="17.72" cy="15.3" r="1.6"/><circle class="f" cx="12" cy="18.6" r="1.6"/><circle class="f" cx="6.28" cy="15.3" r="1.6"/><circle class="f" cx="6.28" cy="8.7" r="1.6"/>',
  // The Instagram glyph (as InstagramLink.astro's, drawn to this set's line).
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle class="f" cx="16.6" cy="7.4" r="1.1"/>',
  // A movement on the mat: the spine's dots curling up from the floor, the head leading.
  movement:
    '<path d="M3 20.5h18"/><circle class="f" cx="6" cy="17.5" r="1.1"/><circle class="f" cx="7.38" cy="13.78" r="1.1"/><circle class="f" cx="9.5" cy="11.13" r="1.1"/><circle class="f" cx="12.38" cy="9.53" r="1.1"/><circle cx="16.6" cy="8.6" r="2.1"/>',
  // A body seen within a scan's frame: the head and the spine's dots.
  body: '<path d="M3.5 8V6A2.5 2.5 0 0 1 6 3.5h2M16 3.5h2A2.5 2.5 0 0 1 20.5 6v2M20.5 16v2a2.5 2.5 0 0 1-2.5 2.5h-2M8 20.5H6A2.5 2.5 0 0 1 3.5 18v-2"/><circle cx="12" cy="8.2" r="2"/><circle class="f" cx="12" cy="12.3" r="0.95"/><circle class="f" cx="12" cy="14.7" r="0.95"/><circle class="f" cx="12" cy="17.1" r="0.95"/>',
};

const items = revealOrder.map((id) => {
  const item = homeMenu.find((entry) => entry.id === id)!;
  const { hour } = item;
  const { x, y } = ringPoint(hour);
  const label = item.label[lang];
  const instagram = item.to === 'instagram';
  return {
    hour,
    icon: icons[item.icon],
    label,
    href: instagram ? `https://www.instagram.com/${handle}/` : homepage ? undefined : (item.to as Record<Lang, string>)[lang],
    /** The visible label first, then what the link opens (WCAG 2.5.3). */
    name: instagram ? `${label}, Instagram: @${handle}` : undefined,
    side: hour > 6 ? 'start' : 'end',
    /** Half past 10 and half past 1: the ring curves in above them. */
    high: hour === 10.5 || hour === 1.5,
    /** Half past 4 and half past 7 sit above the line, her ground. */
    low: hour === 4.5 || hour === 7.5,
    left: (x / STAGE) * 100,
    top: (y / STAGE) * 100,
  };
});
---

<nav class="intro__menu ui ring-menu" aria-label={ritual[lang].menuLabel} style={`--icon-rest:${restColour}`}>
  <ul class="ring-menu__items" role="list">
    {
      items.map((item) => (
        <li
          class:list={['ring-menu__item', `ring-menu__item--${item.side}`, item.high && 'ring-menu__item--high', item.low && 'ring-menu__item--low']}
          style={`left:${item.left.toFixed(3)}%;top:${item.top.toFixed(3)}%`}
          data-intro-item
          data-hour={item.hour}
        >
          <a class="ring-menu__link" href={item.href} aria-label={item.name}>
            <span class="ring-menu__mark" aria-hidden="true">
              <svg class="ring-menu__icon" viewBox="0 0 24 24" focusable="false" set:html={item.icon} />
            </span>
            <span class="ring-menu__label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* Set on the intro, so its ring sizes below can use them:
     - the column each side keeps beside the ring for a label at 3 or 9
       o'clock, single words ("Contrology", 75px at 14px Inter 500): half of
       --room-icon's disc, the gap and 4.75rem. The ring is what gives way,
       never a label's place, so the labels stay inside the page's gutter.
       --room-icon is the icon the ring was sized for in the review of
       2026-10-29 (owner: keep the ring as it is), so drawing a smaller icon
       never changes the ring;
     - the icon drawn (48px; on phones a share of the ring, below), and its
       disc of page ground 4px wider all round (it hides the ring under it).
     These override HomeIntro.astro's ring sizes (desktop and tier B), on
     this preview only. */
  :global(.intro.intro--side-labels:has(.ring-menu)) {
    --room-icon: 3rem;
    --menu-column: calc((var(--room-icon) + 0.5rem) / 2 + var(--space-2) + 4.75rem);
    --ring-desktop: min(calc(100svh - 22rem), calc(100vw - 2 * var(--gutter) - 2 * var(--menu-column)), 36rem);
    --icon: 3rem;
    --mark: calc(var(--icon) + 0.5rem);
  }

  /* Phones upright. The ring's room: 26.04vw − 62.5px, 24 to 42px (the
     largest icon that kept neighbours apart). The icon drawn: a fifth of the
     stage, 24 to 36px (24px at 360 wide, 29 at 390, 33 at 414), so it stays
     in proportion to her and the ring (owner, 2026-10-29: smaller on phones). */
  @media (max-width: 47.99rem) and (orientation: portrait) {
    :global(.intro.intro--side-labels:has(.ring-menu)) {
      --room-icon: clamp(1.5rem, 26.04vw - 62.5px, 2.625rem);
      --ring-phone: max(6rem, min(calc(100vw - 2 * var(--gutter) - 2 * var(--menu-column)), calc(100svh - 18.5rem)));
      --icon: clamp(1.5rem, 0.2 * var(--ring), 2.25rem);
    }
  }

  /* Phones sideways (the side column): the ring's room for the narrower
     stage beside the text column, 26.04vw − 123px, 24 to 42px; the icon as
     upright. */
  @media (orientation: landscape) and (max-height: 32rem) and (max-width: 60rem) {
    :global(.intro.intro--side-labels:has(.ring-menu)) {
      --room-icon: clamp(1.5rem, 26.04vw - 123px, 2.625rem);
      --label-room: var(--menu-column);
      --icon: clamp(1.5rem, 0.2 * var(--ring), 2.25rem);
    }
  }

  /* The label's widest line before it wraps: at most what is left beside an
     item on a diagonal (0.3253 of the stage from the centre, then half a
     disc and the gap) before the gutter; on phones at most 6rem, for two
     lines ("The 7 Principles", "The Language of the Body"). */
  .ring-menu {
    --label-max: min(12rem, calc(50vw - var(--gutter) - 0.3253 * var(--ring) - var(--mark) / 2 - var(--space-2)));
  }

  @media (max-width: 47.99rem) and (orientation: portrait), (orientation: landscape) and (max-height: 32rem) and (max-width: 60rem) {
    .ring-menu {
      --label-max: min(6rem, calc(50vw - var(--gutter) - 0.3253 * var(--ring) - var(--mark) / 2 - var(--space-2)));
    }
  }

  .ring-menu__items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The icon's centre on the ring at the item's hour; the label after it on
     the right-hand half, before it on the left. */
  .ring-menu__item {
    position: absolute;
    width: max-content;
    translate: calc(var(--mark) / -2) -50%;
  }

  .ring-menu__item--start {
    translate: calc(-100% + var(--mark) / 2) -50%;
  }

  .ring-menu__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    color: var(--color-text);
    text-decoration: none;
  }

  .ring-menu__item--start .ring-menu__link {
    flex-direction: row-reverse;
    text-align: end;
  }

  /* At rest, the figure's soft sage (--icon-rest, set from her palette). */
  .ring-menu__mark {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--mark);
    height: var(--mark);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--icon-rest);
    scale: calc(0.85 + 0.15 * var(--dot, 1));
    transition: color 220ms cubic-bezier(0.45, 0, 0.25, 1);
  }

  .ring-menu__icon {
    width: var(--icon);
    height: var(--icon);
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: scale 220ms cubic-bezier(0.45, 0, 0.25, 1);
  }

  /* Active: hovered (pointers that hover; a tap would leave it stuck),
     focused from the keyboard, or `data-active` on the item, for the
     presentation cycle once it exists (nothing sets it yet). The icon
     deepens to the stronger sage and grows a little inside its disc; the
     label doesn't move. */
  @media (hover: hover) {
    .ring-menu__link:hover .ring-menu__mark {
      color: var(--color-sage);
    }

    .ring-menu__link:hover .ring-menu__icon {
      scale: 1.12;
    }
  }

  .ring-menu__link:focus-visible .ring-menu__mark,
  .ring-menu__item[data-active] .ring-menu__mark {
    color: var(--color-sage);
  }

  .ring-menu__link:focus-visible .ring-menu__icon,
  .ring-menu__item[data-active] .ring-menu__icon {
    scale: 1.12;
  }

  /* Reduced motion: the colour still changes (at once, global.css), the
     icon doesn't grow. */
  @media (prefers-reduced-motion: reduce) {
    .ring-menu .ring-menu__item .ring-menu__icon {
      scale: none;
    }
  }

  .ring-menu__icon :global(.f) {
    fill: currentColor;
    stroke: none;
  }

  .ring-menu__label {
    max-width: var(--label-max);
    line-height: 1.25;
    text-wrap: balance;
  }

  /* A label of two lines at half past 10 or 1 grows upwards from the icon's
     line (its last line beside the icon), where the ring curves away from it. */
  .ring-menu__item--high .ring-menu__label {
    translate: 0 calc(0.5lh - 50%);
  }

  /* The line, her ground, is 9.79% of the stage below half past 4 and 7: on
     a small ring it would cross those labels, so they rise just clear of it
     (no change where the ring is large enough). The icon stays on its hour. */
  .ring-menu__item--low .ring-menu__label {
    translate: 0 min(0px, calc(0.0979 * var(--ring) - 50% - 2px));
  }

  /* On the narrowest screens (upright under 392px wide, a stage under about
     145px) these labels start beyond the line's end (it reaches 1.1 radii
     each side), so nothing needs clearing; lifted, a two-line label would
     meet the item at 9 or 3 o'clock. They hang down from the icon's line
     instead (its first line beside the icon). */
  @media (max-width: 24.5rem) and (orientation: portrait), (orientation: landscape) and (max-height: 32rem) and (max-width: 39.5rem) {
    .ring-menu__item--low .ring-menu__label {
      translate: 0 calc(50% - 0.5lh);
    }
  }

  .ring-menu__link[href]:hover .ring-menu__label {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  /* Live: hidden until the scene fades them in (its inline styles then rule). */
  :global(.intro--live) .ring-menu__item {
    --dot: 0;
  }

  :global(.intro--live) .ring-menu__link {
    opacity: 0;
    visibility: hidden;
  }

  /* On the homepage, every state but the intro's (`starting`, `playing`) is
     the menu, shown from the first paint, as HomeIntro.astro does for its
     own items; and no transition (HomeIntro.astro's note: the stop control
     hands focus to a link the scene has just shown). */
  :global(:root:not([data-intro='starting'], [data-intro='playing']) [data-intro-homepage]) .ring-menu__item {
    --dot: 1;
  }

  :global(:root:not([data-intro='starting'], [data-intro='playing']) [data-intro-homepage]) .ring-menu__link {
    opacity: 1;
    visibility: visible;
  }

  :global([data-intro-homepage]) .ring-menu__link {
    transition: none;
  }
</style>
