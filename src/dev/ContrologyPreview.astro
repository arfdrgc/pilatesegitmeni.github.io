---
// Development-only preview of the Contrology page: ContrologyArticle inside a
// copy of the real page's frame. /contrology/ and /en/contrology/ render the
// same component and config, so the two can't drift apart. Rendered by the routes in src/pages/dev/contrology-preview/
// and src/pages/en/dev/contrology-preview/ under `astro dev` only; a production
// build has no such page. Remove this file and the two routes when no longer
// needed; the article and its config stay for production.
//
// Why a copy of the frame and not SectionPage itself: SectionPage passes the
// real pages' paths as `translations`, and SeoHead requires them to include the
// current page, so it can't render at a preview URL (as in LegacyPreview.astro).
// The markup and styles below mirror src/components/SectionPage.astro; that file
// is unchanged.
//
// The notice under the heading is development-only (data-dev-only).
import ContrologyArticle from '../components/contrology/ContrologyArticle.astro';
import { contrologyDescription } from '../config/contrology';
import { homeMenu } from '../config/home-menu';
import { getLang, homePath, t } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = getLang(Astro.currentLocale);
const name = homeMenu.find((item) => item.id === 'contrology')!.label[lang];
const translations = { tr: '/dev/contrology-preview/', en: '/en/dev/contrology-preview/' };
const notice = {
  tr: 'Geliştirme önizlemesi: /contrology/ sayfasıyla aynı içerik.',
  en: 'Development preview: the same content as /en/contrology/.',
};
---

<BaseLayout title={`${name} (dev preview) | Pilates Eğitmeni`} description={contrologyDescription[lang]} translations={translations} lockup>
  <div class="section-page container">
    <h1 class="section-page__title display">{name}</h1>
    <p class="preview-notice ui" data-dev-only>{notice[lang]}</p>
    <div class="section-page__content">
      <ContrologyArticle lang={lang} />
    </div>
    <a class="section-page__home ui" href={homePath(lang)}>{t(lang).backToHome}</a>
  </div>
</BaseLayout>

<style>
  /* As in src/components/SectionPage.astro. */
  .section-page {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: var(--section-pad);
  }

  .section-page__content {
    align-self: stretch;
    min-height: min(45svh, 28rem);
    margin-block: var(--space-5);
    border-top: 1px solid var(--color-rule);
  }

  .section-page__home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-text);
    color: var(--color-text);
    text-decoration: none;
  }

  .section-page__home:hover {
    box-shadow: inset 0 0 0 1px var(--color-text);
  }

  /* Development only. */
  .preview-notice {
    max-width: 36rem;
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
</style>
