---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getLang, t, type Translations } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  /** Every built language version of this page, including the current one. */
  translations: Translations;
  /** Only for src/pages/404.astro, which passes empty translations. */
  notFound?: boolean;
  /** The approved A · Open lockup in place of the wordmark PNG: on the coming-soon pages (/ and /en/) and the 404 page. */
  lockup?: boolean;
  /** The page shows the homepage intro (components/home-intro/homepage.ts): on the coming-soon pages. */
  ritual?: boolean;
}

const { title, description, translations, notFound, lockup, ritual } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead title={title} description={description} lang={lang} translations={translations} notFound={notFound} />
    {
      /*
        The homepage intro's state, set before the first paint (see
        components/home-intro/homepage.ts; the key is the welcome ritual's,
        which the intro replaced): it plays once per browser tab, the first
        time a page with it opens; one key for both languages. Reduced
        motion: no state, so the approved reduced-motion version shows.
        Already played in this tab, or session storage unavailable: at rest,
        never replayed automatically. If the player hasn't started within 3 s
        (its script failed or is very late), at rest too; a started player is
        never interrupted, as it has left `starting` by then.
      */
      ritual && (
        <script is:inline>
          (() => {
            const html = document.documentElement;
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            const key = 'pilatesegitmeni:welcome-ritual';
            let first = false;
            try {
              if (sessionStorage.getItem(key) === null) {
                sessionStorage.setItem(key, 'played');
                first = sessionStorage.getItem(key) === 'played';
              }
            } catch {}
            html.dataset.intro = first ? 'starting' : 'rest';
            if (first) {
              setTimeout(() => {
                if (html.dataset.intro === 'starting') html.dataset.intro = 'rest';
              }, 3000);
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang).skipToContent}</a>
    <SiteHeader lang={lang} translations={translations} lockup={lockup} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} translations={translations} lockup={lockup} />
  </body>
</html>
