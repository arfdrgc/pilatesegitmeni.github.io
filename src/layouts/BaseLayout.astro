---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getLang, t, type Translations } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  /** Every built language version of this page, including the current one. */
  translations: Translations;
  /** Only for src/pages/404.astro, which passes empty translations. */
  notFound?: boolean;
  /** The approved A · Open lockup in place of the wordmark PNG: on the coming-soon pages (/ and /en/) and the 404 page. */
  lockup?: boolean;
}

const { title, description, translations, notFound, lockup } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead title={title} description={description} lang={lang} translations={translations} notFound={notFound} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang).skipToContent}</a>
    <SiteHeader lang={lang} translations={translations} lockup={lockup} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} translations={translations} lockup={lockup} />
  </body>
</html>
