---
// TEMPORARY development-only route: /en/dev/seven-principles-preview/, the
// 7 Principles page preview (src/dev/SevenPrinciplesPreview.astro). A production
// build gets no paths, so it emits no page, and the preview is imported only
// under `astro dev`, so its CSS isn't bundled either. Remove once the owner has
// reviewed it.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: undefined } }] : [];
}

const Preview = import.meta.env.DEV ? (await import('../../../../dev/SevenPrinciplesPreview.astro')).default : null;
---

{Preview && <Preview />}
