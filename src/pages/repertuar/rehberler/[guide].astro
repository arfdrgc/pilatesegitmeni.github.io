---
// Repertuar context guides (tr). The segment is a path only: there is no
// guide index page.
import GuidePage from '../../../components/repertoire/GuidePage.astro';
import { getRepertoire, type GuidePageProps } from '../../../lib/repertoire';

export async function getStaticPaths() {
  return (await getRepertoire()).guidePages.tr;
}

type Props = GuidePageProps;
---

<GuidePage {...Astro.props} />
