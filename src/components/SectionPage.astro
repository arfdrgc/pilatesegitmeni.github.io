---
// The page of one ring-menu section, in the language of its URL. Its name and
// both language paths come from src/config/home-menu.ts. Real content goes in
// the slot: <SectionPage id="…">…</SectionPage>. Until then the area stays empty,
// with no placeholder text.
import { homeMenu, type MenuItem } from '../config/home-menu';
import { getLang, homePath, t } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  id: MenuItem['id'];
}

const { id } = Astro.props;
const lang = getLang(Astro.currentLocale);
const section = homeMenu.find((item) => item.id === id)!;
const name = section.label[lang];

// The second sentence is the first of the homepage's meta description
// (src/config/coming-soon.json), so the line claims nothing new about the section.
const descriptions = {
  tr: `${name}: Pilates Eğitmeni'nin bir bölümü. Pilates hakkında öğretici ve farkındalık yaratan bilgiler.`,
  en: `${name}: a section of Pilates Eğitmeni. Educational, awareness-raising information about Pilates.`,
};
---

<BaseLayout title={`${name} | Pilates Eğitmeni`} description={descriptions[lang]} translations={section.to} lockup>
  <div class="section-page container">
    <h1 class="section-page__title display">{name}</h1>
    <div class="section-page__content">
      <slot />
    </div>
    <a class="section-page__home ui" href={homePath(lang)}>{t(lang).backToHome}</a>
  </div>
</BaseLayout>

<style>
  .section-page {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: var(--section-pad);
  }

  /* Reserved for the section's content: open page ground under a hairline. */
  .section-page__content {
    align-self: stretch;
    min-height: min(45svh, 28rem);
    margin-block: var(--space-5);
    border-top: 1px solid var(--color-rule);
  }

  /* Outlined button, as on the 404 page. */
  .section-page__home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-text);
    color: var(--color-text);
    text-decoration: none;
  }

  .section-page__home:hover {
    box-shadow: inset 0 0 0 1px var(--color-text);
  }
</style>
