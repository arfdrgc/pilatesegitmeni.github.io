---
// The content of the Miras / Legacy page, for SectionPage's slot: "Following a
// life" (design approved by the owner on 2026-11-03). Outline, copy, figures and
// the approved page wording: src/config/legacy.ts. Rendered by /miras/ and
// /en/legacy/, and by the development preview (src/dev/LegacyPreview.astro).
//
// - The opening: the approved name line, then [0.1] and [0.2], and a
//   photograph beside them (after them on phones).
// - The life line: the five chapters as stops on one line that ends with his
//   life (1967), not to scale; a link to what came after. An ordered list of
//   links; the line is drawn by CSS.
// - Each chapter: its place on the line, its heading (title, then place and
//   years as a label), and its own composition. The patent sheets sit beside
//   the paragraph they belong to, as documents; so do the photographs of the
//   New York chapter (LegacyPhoto.astro).
// - The last chapter ends with "1967 sonrası / After 1967", set apart by space.
// - The closing [6.1], the sources, and a band with links to other sections.
//
// The patent drawings are shown whole, as published: no crop, no recolouring.
// Astro only resizes them for the srcset. They stay PNG, and quality 100 makes
// sharp write a palette PNG: pixel-identical to its default PNG output for
// these greyscale sheets (measured, 0 pixels differ) at about half the size.
// "Full size" links to the untouched original.
import { Image } from 'astro:assets';
import {
  legacyChapters,
  legacyClosing,
  legacyCopy,
  legacyFigurePlacement,
  legacyFigures,
  legacyFigureText,
  legacyLabels,
  legacyLegalReview,
  legacyOpening,
  legacyOpeningPhoto,
  legacyPhotoPlacement,
  legacySources,
  legacySourcesTitle,
  type LegacyChapter,
  type LegacyFigure,
  type LegacyFigureId,
  type LegacyParagraphId,
  type LegacyPhotoId,
} from '../../config/legacy';
import { homeMenu } from '../../config/home-menu';
import { inspiration } from '../../config/inspiration';
import type { Lang } from '../../i18n/ui';
import InstagramInvite from '../inspiration/InstagramInvite.astro';
import LegacyParagraph from './LegacyParagraph.astro';
import LegacyPhoto from './LegacyPhoto.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = legacyCopy[lang];
const labels = legacyLabels[lang];
const text = legacyFigureText[lang];
const figuresAfter = new Map<LegacyParagraphId, LegacyFigureId[]>(
  legacyFigurePlacement.map(({ after, figures }) => [after, figures]),
);

const photosAfter = new Map<LegacyParagraphId, LegacyPhotoId>(legacyPhotoPlacement.map(({ after, photo }) => [after, photo]));

const blocked = (id: LegacyParagraphId) => !legacyLegalReview.cleared && legacyLegalReview.paragraphs.includes(id);
const shown = (id: LegacyParagraphId) => Boolean(!blocked(id) && copy[id]);

// An approved heading's title and its place and years, split at " · ".
const split = (heading: string) => {
  const at = heading.indexOf(' · ');
  return at < 0 ? { title: heading, place: null } : { title: heading.slice(0, at), place: heading.slice(at + 3) };
};

const anchor = (id: string) => `legacy-${id}`;
const afterAnchor = anchor('after-1967');

type BodyItem =
  | { kind: 'paragraph'; id: LegacyParagraphId; row: number }
  | { kind: 'documents'; figures: LegacyFigureId[]; row: number; span: number }
  | { kind: 'photo'; photo: LegacyPhotoId; row: number; span: number; last: boolean };

// A chapter's body: its paragraphs on rows 1…n; each group of patent sheets or
// photograph beside the paragraph it follows (wide screens only; see the CSS).
const bodyOf = (chapter: LegacyChapter): BodyItem[] => {
  const ids = chapter.paragraphs.filter(shown);
  const asides = ids.map((id) => {
    return figuresAfter.has(id) || photosAfter.has(id);
  });
  return ids.flatMap((id, i): BodyItem[] => {
    const paragraph: BodyItem = { kind: 'paragraph', id, row: i + 1 };
    if (!asides[i]) return [paragraph];
    const next = asides.findIndex((aside, j) => j > i && aside);
    const span = (next < 0 ? ids.length : next) - i;
    const figures = figuresAfter.get(id);
    return figures
      ? [paragraph, { kind: 'documents', figures, row: i + 1, span }]
      : [paragraph, { kind: 'photo', photo: photosAfter.get(id)!, row: i + 1, span, last: i === ids.length - 1 }];
  });
};
const after1967 = legacyChapters.flatMap((chapter) => chapter.after1967 ?? []).filter(shown);

// A single sheet is 18rem wide from 48rem, a pair's sheets 12rem each; on
// phones a single sheet is 75% of the screen, a pair's sheets half each.
const sizesFor = (count: number) =>
  count > 1 ? '(min-width: 48rem) 12rem, calc(50vw - 1.75rem)' : '(min-width: 48rem) 18rem, 75vw';

// The patent's own title stays in English; on the Turkish page it is marked as such.
const titleLang = lang === 'en' ? undefined : 'en';
const details = (figure: LegacyFigure) =>
  [`${text.filed} ${figure.filed}`, `${text.granted} ${figure.granted}`, text.sheet(figure.sheet, figure.sheets)].join(' · ');

// The band: links to the sections that have content, under their menu names.
const bandLinks = (['body', 'inspiration'] as const).map((id) => homeMenu.find((item) => item.id === id)!);
const instagram = inspiration[lang];
---

<div class="legacy">
  <div class="opening">
    <p class="opening__name place">{labels.name}</p>
    {
      shown('0.1') && (
        <div class="slot opening__statement">
          <LegacyParagraph lang={lang} id={legacyOpening[0]} />
        </div>
      )
    }
    {
      shown('0.2') && (
        <div class="slot opening__intro">
          <LegacyParagraph lang={lang} id={legacyOpening[1]} />
        </div>
      )
    }
    <div class="opening__photo">
      <LegacyPhoto lang={lang} id={legacyOpeningPhoto} sizes="(min-width: 48rem) 14rem, 60vw" eager />
    </div>
  </div>

  <nav class="life" aria-label={labels.chapters}>
    <ol class="life__stops">
      {
        legacyChapters.map((chapter) => {
          const { title, place } = split(chapter.title[lang]);
          return (
            <li class="life__stop">
              <a class="life__link" href={`#${anchor(chapter.id)}`}>
                <span class="life__title">{title}</span>
                {place && (
                  <>
                    <span class="visually-hidden"> · </span>
                    <span class="life__place place">{place}</span>
                  </>
                )}
              </a>
            </li>
          );
        })
      }
    </ol>
    {
      after1967.length > 0 && (
        <a class="life__after ui" href={`#${afterAnchor}`}>
          {labels.after1967}
          <span aria-hidden="true">&nbsp;→</span>
        </a>
      )
    }
  </nav>

  {
    legacyChapters.map((chapter, index) => {
      const { title, place } = split(chapter.title[lang]);
      const headingId = `${anchor(chapter.id)}-title`;
      const afterIds = (chapter.after1967 ?? []).filter(shown);
      return (
        <section id={anchor(chapter.id)} class:list={['chapter', `chapter--${chapter.id}`]} aria-labelledby={headingId}>
          {/* This chapter's place on the life line. */}
          <div class="stops" aria-hidden="true">
            {legacyChapters.map((_, j) => (
              <span class:list={['stops__dot', j === index && 'stops__dot--here']} />
            ))}
            <span class="stops__end" />
          </div>

          <h2 class="chapter__heading" id={headingId}>
            <span class="chapter__title">{title}</span>
            {place && (
              <>
                <span class="visually-hidden"> · </span>
                <span class="chapter__place place">{place}</span>
              </>
            )}
          </h2>

          {chapter.numeral && (
            <p class="chapter__numeral" aria-hidden="true">
              {chapter.numeral}
            </p>
          )}

          <div class="chapter__body" style={`--rows: ${chapter.paragraphs.filter(shown).length}`}>
            {bodyOf(chapter).map((item) =>
              item.kind === 'paragraph' ? (
                <div class="slot" data-p={item.id} style={`--row: ${item.row}`}>
                  <LegacyParagraph lang={lang} id={item.id} />
                </div>
              ) : item.kind === 'photo' ? (
                <div
                  class:list={['photos', item.last && 'photos--last']}
                  style={`--row: ${item.row}; --row-after: ${item.row + 1}`}
                >
                  <LegacyPhoto lang={lang} id={item.photo} sizes="(min-width: 48rem) 18rem, 75vw" />
                </div>
              ) : (
                <div
                  class:list={['documents', item.figures.length > 1 && 'documents--pair']}
                  style={`--row: ${item.row}`}
                >
                  <div class="documents__row">
                    {item.figures.map((figureId) => {
                      const figure = legacyFigures[figureId];
                      return (
                        <figure class="document">
                          <div class="document__mount">
                            <Image
                              src={figure.src}
                              alt={figure.alt[lang]}
                              widths={[400, 600, 900, 1200]}
                              sizes={sizesFor(item.figures.length)}
                              format="png"
                              quality={100}
                              class="document__image"
                            />
                          </div>
                          <figcaption class="document__caption">
                            <span class="document__name">
                              {figure.inventor}, <cite lang={titleLang}>{figure.title}</cite>.
                            </span>{' '}
                            <a href={figure.href}>
                              {text.patent} {figure.number}
                            </a>{' '}
                            · {details(figure)} · <a href={figure.src.src}>{labels.fullSize}</a>
                          </figcaption>
                        </figure>
                      );
                    })}
                  </div>
                  <p class="documents__credit">{text.credit}</p>
                </div>
              ),
            )}
          </div>

          {afterIds.length > 0 && (
            <section class="after" id={afterAnchor} aria-labelledby={`${afterAnchor}-title`}>
              <h3 class="after__title label" id={`${afterAnchor}-title`}>
                {labels.after1967}
              </h3>
              {afterIds.map((id) => (
                <div class="slot" data-p={id}>
                  <LegacyParagraph lang={lang} id={id} />
                </div>
              ))}
            </section>
          )}
        </section>
      );
    })
  }

  <div class="closing">
    {
      legacyClosing.filter(shown).map((id) => (
        <div class="slot closing__note" data-p={id}>
          <LegacyParagraph lang={lang} id={id} />
        </div>
      ))
    }
    <section class="sources" aria-labelledby="legacy-sources-title">
      <h2 class="sources__title" id="legacy-sources-title">{legacySourcesTitle[lang]}</h2>
      <div class="sources__groups">
        {
          legacySources.map((group) => (
            <div class="sources__group">
              <h3 class="sources__label label">{group.label[lang]}</h3>
              <ul class="sources__list">
                {group.references.map((reference) => (
                  <li lang={reference.lang === lang ? undefined : reference.lang}>
                    {reference.before}
                    <a href={reference.href}>{reference.title}</a>
                    {reference.after}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <div class="band">
    <ul class="band__links">
      {
        bandLinks.map((item) => (
          <li>
            <a class="band__link" href={item.to[lang]}>
              {item.label[lang]}
            </a>
          </li>
        ))
      }
    </ul>
    <InstagramInvite label={instagram.followLink} name={instagram.followLinkName} />
  </div>
</div>

<style>
  /* Phones first: one column in the document's order. */
  .legacy {
    --text-width: 38rem;
    --dot: 7px;
    overflow-wrap: break-word;
  }

  .slot {
    max-width: var(--text-width);
  }

  /*
   * Places, years and the name line: small interface type in the text's own
   * case. Not uppercased like .label: in Turkish, CSS capitals would turn the
   * English and German names into "PİLATES" and "EİGHTH".
   */
  .place {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  /* The opening: the person first, then the page's two opening paragraphs. */
  .opening {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-6);
  }

  .opening__name {
    color: var(--color-accent);
  }

  .opening__statement {
    max-width: 46rem;
    font-size: var(--text-cover);
    font-weight: 350;
    line-height: 1.08;
    letter-spacing: -0.022em;
  }

  .opening__intro {
    max-width: 36rem;
    margin-top: var(--space-3);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  /* The opening's photograph: smaller than the statement, after the text on phones. */
  .opening__photo {
    width: 60%;
    max-width: 16rem;
    margin-top: var(--space-3);
  }

  /*
   * The life line. Phones: down the left edge, a dot at each chapter, ending
   * with a short crossbar. Wider screens: across, the five chapters evenly
   * spaced, the line ending with an upright bar after the last chapter.
   */
  .life {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-bottom: var(--section-pad);
  }

  .life__stops {
    position: relative;
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0 0 0 1.75rem;
    list-style: none;
  }

  .life__stops::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    bottom: -1.25rem;
    left: calc(var(--dot) / 2 - 0.5px);
    border-left: 1px solid var(--color-text);
  }

  .life__stops::after {
    content: '';
    position: absolute;
    bottom: -1.25rem;
    left: calc(var(--dot) / 2 - 6.5px);
    width: 13px;
    border-top: 1px solid var(--color-text);
  }

  .life__stop {
    position: relative;
  }

  .life__stop::before {
    content: '';
    position: absolute;
    top: calc(0.75rem - var(--dot) / 2);
    left: -1.75rem;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--color-text);
  }

  .life__link {
    display: grid;
    gap: var(--space-1);
    color: var(--color-text);
    text-decoration: none;
  }

  .life__title {
    font-size: var(--text-lead);
    line-height: 1.3;
  }

  .life__link:hover .life__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .life__place {
    color: var(--color-muted);
  }

  .life__after {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-top: var(--space-4);
    color: var(--color-muted);
    text-decoration-color: var(--color-rule);
  }

  .life__after:hover {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  /* A chapter: its place on the line, the heading, then its own composition. */
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-5);
    padding-block: var(--section-pad);
    border-top: 1px solid var(--color-rule);
    scroll-margin-top: var(--space-4);
  }

  .stops {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 9rem;
    height: 13px;
  }

  .stops::before {
    content: '';
    position: absolute;
    top: 6px;
    right: 0;
    left: calc(var(--dot) / 2);
    border-top: 1px solid var(--color-text);
  }

  .stops__dot {
    position: relative;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--color-text);
  }

  .stops__dot--here {
    width: 11px;
    height: 11px;
    background: var(--color-accent);
  }

  .stops__end {
    width: 1px;
    height: 13px;
    background: var(--color-text);
  }

  .chapter__heading {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .chapter__title {
    font-size: var(--text-h2);
    font-weight: 350;
    line-height: 1.1;
    letter-spacing: var(--tracking-heading);
  }

  .chapter__place {
    color: var(--color-accent);
  }

  /* A year or a number from the heading, large and light; decoration only. */
  .chapter__numeral {
    color: var(--color-muted);
    font-size: clamp(4.5rem, 2.5rem + 9vw, 11rem);
    font-weight: 200;
    font-variant-numeric: lining-nums;
    line-height: 0.85;
    letter-spacing: -0.04em;
  }

  .chapter__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  /* The opening sentence of the war years, and the first text after 1967, a size up. */
  .slot[data-p='2.1'],
  .slot[data-p='5.4'] {
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  /* "1967 sonrası": set apart by space and its label, not by a line. */
  .after {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .after__title {
    color: var(--color-accent);
  }

  /* The patent sheets: documents beside the story, never larger than it. */
  .documents {
    display: grid;
    gap: var(--space-3);
    width: 75%;
    margin-block: var(--space-3);
    margin-inline: auto;
  }

  .documents--pair {
    width: 100%;
  }

  /* Photographs in the chapters: the patent sheets' single width, shown whole. */
  .photos {
    width: 75%;
    margin-block: var(--space-3);
    margin-inline: auto;
  }

  .documents__row {
    display: grid;
    gap: var(--space-4);
  }

  .documents--pair .documents__row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .document {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  /* The sheet as published, on a thin linen mount, a hairline round its white paper. */
  .document__mount {
    padding: var(--space-2);
    background: var(--color-surface);
  }

  .document__mount :global(.document__image) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-rule);
  }

  .document__caption,
  .documents__credit {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .document__name {
    color: var(--color-text);
  }

  .document__caption cite {
    font-style: italic;
  }

  .document__caption a {
    color: inherit;
  }

  .document__caption a:hover {
    color: var(--color-text);
  }

  /* The closing note and the sources: quieter than the story. */
  .closing {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-5);
    border-top: 1px solid var(--color-rule);
  }

  .closing__note {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    line-height: 1.55;
  }

  /* Sources: quieter than the story, in interface type (as on Bedenin Dili). */
  .sources {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    line-height: 1.55;
  }

  .sources__title {
    margin-bottom: var(--space-5);
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--text-card);
    font-weight: 350;
    letter-spacing: -0.008em;
  }

  .sources__groups {
    display: grid;
    gap: var(--space-5);
  }

  .sources__label {
    margin-bottom: var(--space-3);
    color: var(--color-muted);
    line-height: 1.4;
  }

  .sources__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The band: on to the other sections, and to Instagram. */
  .band {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-4);
    background: var(--color-panel);
  }

  .band__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .band__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-text);
    font-size: var(--text-card);
    text-decoration-color: var(--color-muted);
  }

  .band__link:hover {
    text-decoration-color: currentColor;
  }

  /* Tablets: the line across the page, the war years' two voices side by side,
     the sheets at their fixed widths under their paragraphs. */
  @media (min-width: 48rem) {
    .life {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      column-gap: var(--space-6);
    }

    .life__stops {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: var(--space-4);
      width: 100%;
      padding: 1.75rem 0 0;
    }

    .life__stops::before {
      top: calc(var(--dot) / 2 - 0.5px);
      right: 0;
      bottom: auto;
      left: calc(var(--dot) / 2);
      border-top: 1px solid var(--color-text);
      border-left: 0;
    }

    .life__stops::after {
      top: calc(var(--dot) / 2 - 6.5px);
      right: 0;
      bottom: auto;
      left: auto;
      width: 0;
      height: 13px;
      border-top: 0;
      border-left: 1px solid var(--color-text);
    }

    .life__stop {
      padding-right: var(--space-3);
    }

    .life__stop::before {
      top: -1.75rem;
      left: 0;
    }

    .life__after {
      margin-top: calc(var(--dot) / 2 - var(--tap-min) / 2);
    }

    .chapter--war-years .chapter__body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-5);
    }

    .chapter--war-years .slot[data-p='2.1'],
    .chapter--war-years .slot[data-p='2.4'] {
      grid-column: 1 / -1;
    }

    .documents {
      width: 18rem;
      margin-inline: 0;
    }

    .documents--pair {
      width: calc(24rem + var(--space-4));
    }

    .opening__photo {
      width: 14rem;
    }

    .photos {
      width: 18rem;
      margin-inline: 0;
    }

    .sources__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .band {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      padding: var(--space-6) var(--space-5);
    }
  }

  /* Desktop: twelve columns, and a different composition for each chapter. */
  @media (min-width: 64rem) {
    .opening {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-4);
    }

    .opening__name {
      grid-column: 1 / 10;
      grid-row: 1;
    }

    .opening__statement {
      grid-column: 1 / 9;
      grid-row: 2;
    }

    .opening__intro {
