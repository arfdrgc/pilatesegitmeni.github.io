---
import { Picture } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import { articleSlug, articleUrl, type Article } from '../../lib/articles';
import ArticleMeta from '../ArticleMeta.astro';

interface Props {
  article: Article;
  lang: Lang;
}

const { article, lang } = Astro.props;
const { title, description, cover, draft, sample } = article.data;
const titleId = `featured-${articleSlug(article)}`;
// Development-only markers; check-dist fails the build if either reaches production.
const markers = {
  ...(sample ? { 'data-sample': '' } : {}),
  ...(draft ? { 'data-dev-only': '' } : {}),
};
---

<section class="featured-panel" aria-labelledby={titleId} {...markers}>
  <article class:list={['featured container', cover ? 'featured--image' : 'featured--text']}>
    {
      cover && (
        <figure class="featured__figure">
          <Picture
            src={cover.src}
            alt={cover.alt}
            formats={['avif', 'webp']}
            widths={[400, 600, 800, 1000, 1200]}
            sizes="(min-width: 80rem) 33rem, (min-width: 48rem) 42vw, 100vw"
            width={1000}
            height={1250}
            fit="cover"
            priority
            class="featured__image"
          />
          <figcaption class="featured__credit ui">
            {t(lang).photoCredit} {cover.credit}
          </figcaption>
        </figure>
      )
    }
    <div class="featured__body">
      <div class="featured__eyebrow">
        <p class="featured__label label">{t(lang).featured}</p>
        <ArticleMeta article={article} lang={lang} part="category" />
      </div>
      <h2 id={titleId} class="featured__title">
        <a href={articleUrl(article)}>{title}</a>
      </h2>
      <p class="featured__summary">{description}</p>
      <ArticleMeta article={article} lang={lang} part="date" class="featured__date" />
    </div>
  </article>
</section>

<style>
  .featured-panel {
    background: var(--color-panel);
    border-block: 1px solid var(--color-rule);
  }

  /* Mobile: the image runs edge to edge at the top of the panel. */
  .featured {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--section-pad);
  }

  .featured--text {
    padding-top: var(--section-pad);
  }

  .featured__figure {
    margin-inline: calc(-1 * var(--gutter));
  }

  .featured__figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .featured__credit {
    margin-top: var(--space-2);
    padding-inline: var(--gutter);
    color: var(--color-muted);
    font-size: var(--text-small);
    font-weight: 400;
  }

  .featured__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .featured__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .featured__label {
    color: var(--color-accent);
  }

  .featured__title {
    font-size: var(--text-cover);
    font-weight: 350;
    line-height: 1.05;
    letter-spacing: -0.022em;
  }

  .featured__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .featured__title a:hover {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .featured__summary {
    max-width: 30em;
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .featured__body :global(.featured__date) {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
    font-weight: 400;
  }

  /* Desktop: image and text side by side inside the page width. */
  @media (min-width: 48rem) {
    .featured {
      padding-top: var(--section-pad);
    }

    .featured--image {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(2.5rem, 6vw, 6rem);
      align-items: center;
    }

    .featured__figure {
      margin-inline: 0;
    }

    .featured__credit {
      padding-inline: 0;
    }
  }
</style>
