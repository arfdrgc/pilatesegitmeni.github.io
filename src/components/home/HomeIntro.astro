---
import DevPlaceholder from '../DevPlaceholder.astro';

interface Props {
  statement: string | null;
  supportingLine: string | null;
}

const { statement, supportingLine } = Astro.props;
// In production, missing copy is left out entirely; no empty section remains.
const render = Boolean(statement || supportingLine || import.meta.env.DEV);
---

{
  render && (
    <div class="intro container">
      {statement ? (
        <p class="intro__statement display">{statement}</p>
      ) : (
        <DevPlaceholder as="p" class="intro__statement display" label="marka cümlesi / brand statement (src/config/home.json)" />
      )}
      {supportingLine ? (
        <p class="intro__supporting">{supportingLine}</p>
      ) : (
        <DevPlaceholder as="p" class="intro__supporting" label="destek cümlesi / supporting line (src/config/home.json)" />
      )}
    </div>
  )
}

<style>
  /* Mobile: statement, then a short terracotta rule and the supporting line. */
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--section-pad);
  }

  .intro :global(.intro__statement) {
    max-width: 11.5em;
  }

  .intro :global(.intro__supporting) {
    max-width: 22em;
    color: var(--color-muted);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .intro :global(.intro__supporting)::before {
    content: '';
    display: block;
    width: 3rem;
    margin-bottom: var(--space-4);
    border-top: 1px solid var(--color-accent);
  }

  /* Desktop: the supporting line sits beside the statement, on its last line. */
  @media (min-width: 64rem) {
    .intro {
      flex-direction: row;
      align-items: flex-end;
      gap: var(--space-6);
    }

    .intro :global(.intro__statement) {
      flex: 3 1 0;
      min-width: 0;
    }

    .intro :global(.intro__supporting) {
      flex: 1 1 0;
      min-width: 16rem;
      padding-bottom: 0.5em;
    }
  }
</style>
