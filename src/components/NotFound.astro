---
// Content of the 404 page (src/pages/404.astro). GitHub Pages serves that one
// page for every missing URL, /en/ included, so it holds both languages:
// Turkish first as the default language, then English. No script picks the
// language from the URL.
import { homePath, t } from '../i18n/utils';

const tr = t('tr');
const en = t('en');
---

<div class="not-found container">
  <p class="not-found__code label">404</p>
  <div class="not-found__block">
    <h1 class="not-found__title display">{tr.notFoundTitle}</h1>
    <p class="not-found__text">{tr.notFoundText}</p>
    <a class="not-found__home ui" href={homePath('tr')}>{tr.backToHome}</a>
  </div>
  <div class="not-found__block not-found__block--en" lang="en">
    <h2 class="not-found__subtitle">{en.notFoundTitle}</h2>
    <p class="not-found__text">{en.notFoundText}</p>
    <a class="not-found__home ui" href={homePath('en')} hreflang="en">{en.backToHome}</a>
  </div>
</div>

<style>
  /* Like the coming-soon page: vertically centred between header and footer. */
  .not-found {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    min-height: min(65svh, 40rem);
    padding-block: var(--section-pad);
  }

  .not-found__code {
    color: var(--color-accent);
  }

  .not-found__block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  /* English sits under a hairline, one step below the Turkish title. */
  .not-found__block--en {
    margin-top: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-rule);
  }

  .not-found__title {
    max-width: 9em;
  }

  .not-found__subtitle {
    font-size: var(--text-h2);
    font-weight: 300;
    letter-spacing: var(--tracking-heading);
  }

  .not-found__text {
    max-width: 26em;
    color: var(--color-muted);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  /* Outlined button, as in the Instagram band, on the page background. */
  .not-found__home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-text);
    color: var(--color-text);
    text-decoration: none;
  }

  .not-found__home:hover {
    box-shadow: inset 0 0 0 1px var(--color-text);
  }

  @media (min-width: 48rem) {
    .not-found {
      gap: var(--space-5);
    }

    .not-found__block--en {
      margin-top: 0;
    }
  }
</style>
