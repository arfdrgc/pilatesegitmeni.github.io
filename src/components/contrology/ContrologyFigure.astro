---
// One explanatory illustration of the Contrology page: an original line diagram
// in inline SVG, in the site's tokens only (lines in text and muted ink, the
// brand green for the dots that carry the idea, never on the sage panel). The
// drawings are decorative (aria-hidden); their meaning is in the visible labels
// and the caption, from src/config/contrology.ts. No script, no image files.
import { contrologyFigures, contrologyTimeline, type ContrologyFigureId } from '../../config/contrology';
import type { Lang } from '../../i18n/ui';

interface Props {
  id: ContrologyFigureId;
  lang: Lang;
}

const { id, lang } = Astro.props;
const words = id === 'timeline' ? null : contrologyFigures[id][lang];
const titleLang = lang === 'en' ? undefined : 'en';

// Learning: the same path placed point by point, repeated, then flowing.
const steps = [
  [10, 58], [34, 30], [58, 52], [82, 24], [110, 46],
] as const;
const polyline = steps.map(([x, y]) => `${x},${y}`).join(' ');
/** The steps as a curve: `tension` 0 is the polyline, 1 is fully smooth (Catmull-Rom). */
function smooth(tension: number, dy = 0) {
  const pts = steps.map(([x, y]) => [x, y + dy] as const);
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(0, i - 1)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(pts.length - 1, i + 2)];
    const k = tension / 6;
    const c1 = [p1[0] + (p2[0] - p0[0]) * k, p1[1] + (p2[1] - p0[1]) * k];
    const c2 = [p2[0] - (p3[0] - p1[0]) * k, p2[1] - (p3[1] - p1[1]) * k];
    d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0]},${p2[1]}`;
  }
  return d;
}
const wave = 'M8,42 C22,16 38,16 52,42 S82,68 96,42 S112,22 114,30';

// Development: two small dot figures, seen from the front.
type Dot = [x: number, y: number, r: number];
const uneven: { dots: Dot[]; bones: [number, number][] } = {
  dots: [
    [60, 14, 7], // head
    [60, 30, 3], // neck
    [44, 36, 10], [76, 36, 10], // shoulders
    [60, 48, 12], // chest
    [36, 56, 8], [84, 56, 8], // upper arms
    [35, 74, 3.2], [85, 74, 3.2], // forearms
    [60, 70, 3], [60, 84, 3.6], // waist, pelvis
    [53, 100, 3.2], [67, 100, 3.2], [52, 118, 3], [68, 118, 3], // legs
  ],
  bones: [[0, 1], [1, 4], [2, 4], [3, 4], [2, 5], [3, 6], [5, 7], [6, 8], [4, 9], [9, 10], [10, 11], [10, 12], [11, 13], [12, 14]],
};
const even: { dots: Dot[]; bones: [number, number][] } = {
  dots: [
    [60, 14, 6], // head
    [60, 28, 3.4], // neck
    [49, 33, 3.4], [71, 33, 3.4], // shoulders
    [41, 21, 3.4], [79, 21, 3.4], // upper arms, reaching up
    [36, 8, 3.4], [84, 8, 3.4], // hands
    [60, 44, 3.4], [60, 58, 3.4], [60, 72, 3.4], // spine
    [60, 85, 3.4], // pelvis
    [53, 100, 3.4], [67, 100, 3.4], [51, 117, 3.4], [69, 117, 3.4], // legs
  ],
  bones: [[0, 1], [1, 2], [1, 3], [2, 4], [3, 5], [4, 6], [5, 7], [1, 8], [8, 9], [9, 10], [10, 11], [11, 12], [11, 13], [12, 14], [13, 15]],
};
const devFigures = [uneven, even];

// Spine: twelve vertebrae rolling onto the floor like a wheel, in three stages
// (nearly seated, halfway, lying). The first `n` lie on the floor; the rest
// follow an arc of radius R that touches the floor where they leave it.
const FLOOR = 82;
const GAP = 8.4;
const R = 46;
function spineDots(onFloor: number) {
  const x0 = 14;
  const dots: [number, number][] = [];
  for (let i = 0; i < 12; i++) {
    if (i < onFloor) dots.push([x0 + i * GAP, FLOOR]);
    else {
      const xn = x0 + (onFloor - 1) * GAP;
      const theta = ((i - onFloor + 1) * GAP) / R;
      dots.push([xn + R * Math.sin(theta), FLOOR - R + R * Math.cos(theta)]);
    }
  }
  return dots.map(([x, y]) => [Number(x.toFixed(2)), Number(y.toFixed(2))] as const);
}
const spineStages = [1, 6, 12].map(spineDots);
---

{
  id === 'timeline' ? (
    <ol class="timeline">
      {contrologyTimeline.map((entry) => (
        <li class="timeline__entry">
          <span class="timeline__dot" aria-hidden="true" />
          <span class="timeline__year">{entry.year}</span>
          <span class="timeline__text ui">
            {entry.text[lang].map((run) => (typeof run === 'string' ? run : 'title' in run ? <cite lang={titleLang}>{run.title}</cite> : run.text))}
          </span>
        </li>
      ))}
    </ol>
  ) : (
    <figure class:list={['figure', `figure--${id}`]}>
      {id === 'learning' && (
        <ol class="steps">
          {words!.labels.map((label, index) => (
            <li class="steps__step">
              <svg class="art" viewBox="0 0 120 70" aria-hidden="true" focusable="false">
                {index === 0 && (
                  <>
                    <polyline class="line" points={polyline} />
                    {steps.map(([x, y]) => (
                      <circle class="dot" cx={x} cy={y} r="3" />
                    ))}
                  </>
                )}
                {index === 1 && (
                  <>
                    <path class="line line--faint" d={smooth(0.35, 6)} />
                    <path class="line line--soft" d={smooth(0.7, 3)} />
                    <path class="line" d={smooth(1)} />
                    <circle class="dot" cx={steps[4][0]} cy={steps[4][1]} r="3" />
                  </>
                )}
                {index === 2 && (
                  <>
                    <path class="line" d={wave} />
                    <circle class="dot" cx="114" cy="30" r="3" />
                  </>
                )}
              </svg>
              <span class="steps__label ui">
                <span class="steps__number" aria-hidden="true">{index + 1}</span>
                {label}
              </span>
            </li>
          ))}
        </ol>
      )}

      {id === 'development' && (
        <ul class="pair">
          {devFigures.map((figure, index) => (
            <li class:list={['pair__item', index === 1 && 'pair__item--even']}>
              <svg class="art art--figure" viewBox="0 0 120 128" aria-hidden="true" focusable="false">
                {figure.bones.map(([a, b]) => (
                  <line class="bone" x1={figure.dots[a][0]} y1={figure.dots[a][1]} x2={figure.dots[b][0]} y2={figure.dots[b][1]} />
                ))}
                {figure.dots.map(([x, y, r]) => (
                  <circle class:list={[index === 1 ? 'dot' : 'mass']} cx={x} cy={y} r={r} />
                ))}
              </svg>
              <span class="pair__label ui">{words!.labels[index]}</span>
            </li>
          ))}
        </ul>
      )}

      {id === 'breath' && (
        <div class="breath">
          <svg class="art art--wide" viewBox="0 0 320 110" aria-hidden="true" focusable="false">
            <line class="rule-line" x1="0" y1="56" x2="320" y2="56" />
            <path class="line" d="M6,40 C40,40 70,96 152,96 C232,96 262,14 314,14" />
            <circle class="dot" cx="152" cy="96" r="4" />
            <circle class="dot" cx="314" cy="14" r="4" />
            <path class="line line--soft" d="M86,30 v22 m-5,-6 l5,6 l5,-6" />
            <path class="line line--soft" d="M236,78 v-22 m-5,6 l5,-6 l5,6" />
          </svg>
          <div class="breath__labels">
            <span class="ui">{words!.labels[0]}</span>
            <span class="ui">{words!.labels[1]}</span>
          </div>
        </div>
      )}

      {id === 'spine' && (
        <div class="spine">
          {spineStages.map((dots, index) => (
            <svg class="art art--spine" viewBox="0 0 136 92" aria-hidden="true" focusable="false">
              <line class="rule-line" x1="0" y1={FLOOR + 4} x2="136" y2={FLOOR + 4} />
              <polyline class="bone" points={dots.map(([x, y]) => `${x},${y}`).join(' ')} />
              {dots.map(([x, y], i) => (
                <circle class="dot" cx={x} cy={y} r={i === 11 ? 5 : 2.6} />
              ))}
              {index < 2 && <path class="line line--soft" d="M126,46 h8 m-4,-4 l4,4 l-4,4" />}
            </svg>
          ))}
        </div>
      )}

      {id === 'habits' && (
        <ul class="habits">
          {words!.labels.map((label, index) => (
            <li class:list={['habits__item', index === 0 && 'habits__item--centre']}>
              <svg class="habits__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                {index === 0 && (
                  <>
                    <path class="line" d="M3.5 11.5 12 4.5l8.5 7" />
                    <path class="line" d="M6 10v9.5h12V10" />
                    <circle class="dot" cx="12" cy="15" r="2" />
                  </>
                )}
                {index === 1 && (
                  <>
                    <circle class="line" cx="12" cy="12.5" r="7.5" />
                    <circle class="line line--soft" cx="12" cy="12.5" r="4" />
                  </>
                )}
                {index === 2 && <path class="line" d="M14.5 4.2a8 8 0 1 0 5.3 11.3 6.4 6.4 0 0 1-5.3-11.3Z" />}
                {index === 3 && (
                  <>
                    <circle class="line" cx="12" cy="12" r="8" />
                    <path class="line" d="M10 9v6M14 9v6" />
                  </>
                )}
                {index === 4 && (
                  <>
                    <circle class="line" cx="12" cy="12" r="3.6" />
                    <path class="line" d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8" />
                  </>
                )}
              </svg>
              <span class="habits__label ui">{label}</span>
            </li>
          ))}
        </ul>
      )}

      <figcaption class="figure__caption">{words!.caption}</figcaption>
    </figure>
  )
}

<style>
  .figure {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-rule);
  }

  .figure__caption {
    max-width: 34rem;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  /* The drawing's parts: lines in ink, the idea's dots in the brand green
     (an approved non-text pair on the paper ground). */
  .art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .line,
  .bone,
  .rule-line {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .line {
    stroke: var(--color-text);
    stroke-width: 1.25;
  }

  .line--soft {
    stroke: var(--color-muted);
    stroke-width: 1;
  }

  .line--faint {
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  .bone {
    stroke: var(--color-muted);
    stroke-width: 1;
  }

  .rule-line {
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  .dot {
    fill: var(--color-brand);
  }

  .mass {
    fill: var(--color-bg);
    stroke: var(--color-muted);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* Learning: three steps in a row, joined by a hairline. */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps__step {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .steps__label {
    display: grid;
    gap: var(--space-1);
    color: var(--color-text);
    font-weight: 400;
  }

  .steps__number {
    color: var(--color-accent);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
  }

  /* Development: two figures side by side. */
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pair__item {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .art--figure {
    max-width: 9rem;
  }

  .pair__label {
    max-width: 12rem;
    color: var(--color-muted);
    font-weight: 400;
  }

  .pair__item--even .pair__label {
    color: var(--color-text);
  }

  /* Breath: one cycle, labelled under its two halves. */
  .breath {
    display: grid;
    gap: var(--space-2);
  }

  .breath__labels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    color: var(--color-text);
  }

  .breath__labels > :last-child {
    text-align: right;
  }

  /* Spine: three stages, left to right. */
  .spine {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  /* Habits: exercise first, the habits beside it. */
  .habits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.25rem, 1fr));
    gap: var(--space-4) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .habits__item {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: var(--space-2);
  }

  .habits__icon {
    width: 2rem;
    height: 2rem;
    overflow: visible;
  }

  .habits__label {
    color: var(--color-muted);
    font-weight: 400;
  }

  .habits__item--centre .habits__label {
    color: var(--color-text);
    font-weight: 500;
  }

  /* Timeline: a vertical line on phones, a horizontal one from tablets up. */
  .timeline {
    --dot: 0.625rem;
    position: relative;
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0 0 0 var(--space-4);
    list-style: none;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: calc(var(--dot) / 2 - 0.5px);
    border-left: 1px solid var(--color-rule);
  }

  .timeline__entry {
    position: relative;
    display: grid;
    gap: var(--space-1);
  }

  .timeline__dot {
    position: absolute;
    top: 0.55rem;
    left: calc(-1 * var(--space-4));
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--color-brand);
  }

  .timeline__year {
    font-size: var(--text-card);
    font-weight: 350;
    line-height: 1.2;
  }

  .timeline__text {
    color: var(--color-muted);
    font-weight: 400;
  }

  @media (min-width: 48rem) {
    .figure {
      padding-block: var(--space-5);
    }

    .steps {
      gap: var(--space-5);
    }

    .spine {
      gap: var(--space-5);
    }

    .timeline {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
      padding: var(--space-5) 0 0;
    }

    .timeline::before {
      top: calc(var(--dot) / 2 - 0.5px);
      right: 0;
      bottom: auto;
      left: 0;
      border-top: 1px solid var(--color-rule);
      border-left: 0;
    }

    .timeline__dot {
      top: calc(-1 * var(--space-5));
      left: 0;
    }
  }
</style>
