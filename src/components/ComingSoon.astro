---
// Temporary public homepage while the site is being prepared (/ and /en/):
// the homepage intro with the approved dot figure (home-intro/HomeIntro.astro,
// the development preview's live frame, plan step 10), played by
// home-intro/homepage.ts. Its slogan is the page's <h1>, with the coming-soon
// line under it; the page's title and meta description stay in
// src/config/coming-soon.json. The language link is in the header only. The
// two-character welcome ritual (ritual/WelcomeRitual.astro) is no longer used
// here and stays on disk. The original homepage (home/HomePage.astro) is
// unchanged and previewable in development at /dev/home/ and /en/dev/home/.
// The ring carries the approved six-item menu (owner, 2026-10-30; the dev
// preview's, ../prototypes/home-intro/SixItemMenu.astro), and once the intro
// has ended the menu's loop plays on (homepage.ts).
import { homeMenu } from '../config/home-menu';
import type { Lang } from '../i18n/ui';
import SixItemMenu from '../prototypes/home-intro/SixItemMenu.astro';
import HomeIntro from './home-intro/HomeIntro.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<HomeIntro lang={lang} frame="live" id="home-intro" figure="dots" homepage menuHours={homeMenu.map((item) => item.hour)}>
  <SixItemMenu slot="menu" lang={lang} homepage />
</HomeIntro>

<script>
  import { startHomepageIntro } from './home-intro/homepage';

  const root = document.querySelector<HTMLElement>('[data-intro-homepage]');
  if (root) startHomepageIntro(root);
</script>
