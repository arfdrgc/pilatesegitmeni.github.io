---
// A group page (R10), or with variant "sub-apparatus" a sub-apparatus page
// (R1): title, diagram, intro, the published movements (verified
// sub-apparatus as anchored sections), and the sources.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { GroupPageProps } from '../../lib/repertoire';
import DevPlaceholder from '../DevPlaceholder.astro';
import MovementList from './MovementList.astro';
import SourceList from './SourceList.astro';
import Statement from './Statement.astro';

type Props = GroupPageProps;

const page = Astro.props;
const { copy } = page;
const ui = copy.ui;
---

<BaseLayout title={`${page.title} | Pilates Eğitmeni`} description={page.intro[0]?.text} translations={page.translations} lockup>
  <article class="container" data-variant={page.variant}>
    <slot name="notice" />
    <nav aria-label={ui?.breadcrumb}>
      <ol class="ui">
        <li><a href={page.breadcrumb.landing.href}>{page.breadcrumb.landing.label}</a></li>
        {page.breadcrumb.trail.map((step) => <li>{step.href ? <a href={step.href}>{step.label}</a> : step.label}</li>)}
      </ol>
    </nav>
    <h1 class="display">{page.title}</h1>
    {
      page.diagram && (
        <figure>
          <Image src={page.diagram.src} alt={page.diagram.alt} widths={[640, 1280]} sizes="(min-width: 60rem) 40rem, 100vw" />
          <figcaption class="ui">
            {page.diagram.credit} · {page.diagram.license}
          </figcaption>
        </figure>
      )
    }
    {page.intro.map((statement) => <Statement statement={statement} voiceLabels={copy.voiceLabels} />)}
    <section>
      <h2>{ui?.movements ?? <DevPlaceholder label="uiLabels.movements" />}</h2>
      {
        page.sections.map((section) => (
          <section id={section.heading?.anchor}>
            {section.heading && <h3>{section.heading.href ? <a href={section.heading.href}>{section.heading.label}</a> : section.heading.label}</h3>}
            <MovementList movements={section.movements} copy={copy} />
          </section>
        ))
      }
    </section>
    <SourceList sources={page.sources} copy={copy} />
  </article>
</BaseLayout>
