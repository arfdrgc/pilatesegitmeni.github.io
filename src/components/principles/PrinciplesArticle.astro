---
// The 7 Prensip / The 7 Principles page's content, for the slot of SectionPage
// on /7-prensip/ and /en/7-principles/ (and the development preview's copy of
// that frame), so the pages and the preview can't drift apart. Copy and sources: src/config/principles.ts (revision 3).
//
// Reading order: the opening (lead and two short paragraphs), a contents list,
// the seven numbered principles in the approved order, each with its source
// label, the closing with links to Contrology and Miras / Legacy, and the
// compact bibliography. The layout follows ContrologyArticle.astro: from
// laptops up, each principle's number, heading and source label sit in a
// narrow column beside its text. No images, no illustrations, no script.
import { principles, principlesClosing, principlesLabels, principlesOpening, principlesSourceLabels, principlesSources, type Run } from '../../config/principles';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const labels = principlesLabels[lang];
/** English titles and citations get lang="en" on the Turkish page. */
const english = lang === 'en' ? undefined : 'en';
const number = (index: number) => String(index + 1).padStart(2, '0');
const isTitle = (run: Run): run is { title: string } => typeof run !== 'string' && 'title' in run;
---

<div class="principles">
  <header class="opening">
    {
      principlesOpening[lang].map((paragraph, index) => (
        <p class:list={[index === 0 ? 'opening__lead' : 'opening__intro']}>
          {paragraph.map((run) => (typeof run === 'string' ? run : isTitle(run) ? <cite lang={english}>{run.title}</cite> : <a href={run.href}>{run.text}</a>))}
        </p>
      ))
    }
  </header>

  <nav class="contents" aria-labelledby="principles-contents">
    <h2 class="contents__title label" id="principles-contents">{labels.contents}</h2>
    <ol class="contents__list">
      {
        principles.map((principle, index) => (
          <li>
            <a class="contents__link" href={`#${principle.id}`}>
              <span class="contents__number" aria-hidden="true">
                {number(index)}
              </span>
              <span>{principle.title[lang]}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    principles.map((principle, index) => (
      <section class="part" id={principle.id} aria-labelledby={`${principle.id}-title`}>
        <header class="part__head">
          <p class="part__number" aria-hidden="true">
            {number(index)}
          </p>
          <h2 class="part__title" id={`${principle.id}-title`}>
            {principle.title[lang]}
          </h2>
          <p class="part__source">
            <span class="visually-hidden">{labels.source}: </span>
            <span class:list={['part__source-mark', `part__source-mark--${principle.source}`]} aria-hidden="true" />
            {principlesSourceLabels[principle.source][lang]}
          </p>
        </header>
        <div class="part__body">
          {principle.paragraphs[lang].map((paragraph) => (
            <p class="part__text">{paragraph.map((run) => (typeof run === 'string' ? run : isTitle(run) ? <cite lang={english}>{run.title}</cite> : <a href={run.href}>{run.text}</a>))}</p>
          ))}
        </div>
      </section>
    ))
  }

  <div class="closing">
    <p class="closing__text">
      {principlesClosing[lang].map((run) => (typeof run === 'string' ? run : isTitle(run) ? <cite lang={english}>{run.title}</cite> : <a href={run.href}>{run.text}</a>))}
    </p>
  </div>

  <section class="sources" aria-labelledby="principles-sources">
    <h2 class="sources__title" id="principles-sources">{labels.sources}</h2>
    <ul class="sources__list">
      {
        principlesSources.map((reference) => (
          <li>
            <span lang={english}>
              {reference.before}
              {reference.title && <cite>{reference.title}</cite>}
              {reference.after}
            </span>
            {reference.link && (
              <>
                {' '}
                <a href={reference.link.href} lang={english}>
                  {reference.link.label}
                </a>
                {'.'}
              </>
            )}
            {reference.note && <> {reference.note[lang]}</>}
          </li>
        ))
      }
    </ul>
    {labels.translations && <p class="sources__note">{labels.translations}</p>}
  </section>
</div>

<style>
  .principles {
    --text-width: 36rem;
    overflow-wrap: break-word;
  }

  /* Opening: a lead and two short paragraphs, as on Contrology. */
  .opening {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    padding-block: var(--space-5) var(--space-6);
  }

  .opening__lead {
    font-size: var(--text-card);
    font-weight: 350;
    line-height: 1.4;
    letter-spacing: -0.008em;
  }

  .opening__intro {
    max-width: var(--text-width);
    color: var(--color-muted);
  }

  /* Contents: the seven principles, numbered. */
  .contents {
    padding-block: var(--space-4) var(--space-5);
    border-top: 1px solid var(--color-rule);
  }

  .contents__title {
    margin-bottom: var(--space-3);
    color: var(--color-muted);
  }

  .contents__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contents__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-height: var(--tap-min);
    padding-block: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
  }

  .contents__link:hover span:last-child {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .contents__number,
  .part__number {
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
  }

  /* Principles: a hairline, the number, heading and source label, then the text. */
  .part {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule);
    scroll-margin-top: var(--space-4);
  }

  .part__head {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .part__title {
    max-width: 20ch;
    font-size: var(--text-h2);
    font-weight: 350;
    letter-spacing: var(--tracking-heading);
  }

  /* The source label: interface type, muted, with a small brand-green mark
     (filled: in the 1945 book; ring: in the book as an idea; none: later term). */
  .part__source {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .part__source-mark {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--color-brand);
    border-radius: 50%;
  }

  .part__source-mark--book {
    background: var(--color-brand);
  }

  .part__source-mark--later {
    border-style: dashed;
  }

  .part__body {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .part__text {
    max-width: var(--text-width);
  }

  /* Closing: the page's scope and the links to Contrology and Miras / Legacy. */
  .closing {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule);
  }

  .closing__text {
    max-width: var(--text-width);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  /* Sources: compact, in interface type, as on Contrology. */
  .sources {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-rule);
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .sources__title {
    margin-bottom: var(--space-4);
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--text-card);
    font-weight: 350;
    letter-spacing: -0.008em;
  }

  .sources__list {
    display: grid;
    gap: var(--space-2);
    max-width: 48rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sources__note {
    margin-top: var(--space-4);
  }

  @media (min-width: 48rem) {
    .contents__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-5);
    }
  }

  /* From laptops: the number, heading and label in a column beside the text. */
  @media (min-width: 64rem) {
    .contents__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .part {
      grid-template-columns: minmax(0, 17rem) minmax(0, 44rem);
      column-gap: var(--space-6);
      padding-block: var(--space-7);
    }

    .part__head {
      position: sticky;
      top: var(--space-5);
      align-self: start;
    }

    .part__title {
      font-size: clamp(2rem, 1.2rem + 1.25vw, 2.5rem);
    }

    .closing,
    .sources {
      grid-template-columns: minmax(0, 17rem) minmax(0, 44rem);
      column-gap: var(--space-6);
    }

    .closing > *,
    .sources > :not(.sources__title) {
      grid-column: 2;
    }

    .sources {
      display: grid;
    }

    .sources__title {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
  }
</style>
